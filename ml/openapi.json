{
  "components": {
    "schemas": {
      "Alternative": {
        "properties": {
          "confidence": {
            "description": "Probability the owner set is correct, 0 to 1",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Confidence",
            "type": "number"
          },
          "owners": {
            "description": "Person ids",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "title": "Owners",
            "type": "array"
          }
        },
        "required": [
          "owners",
          "confidence"
        ],
        "title": "Alternative",
        "type": "object"
      },
      "AssignmentSource": {
        "enum": [
          "manual",
          "predicted_accepted",
          "predicted_corrected"
        ],
        "title": "AssignmentSource",
        "type": "string"
      },
      "Discount": {
        "properties": {
          "amount_cents": {
            "description": "Discount size as a positive amount",
            "minimum": 0.0,
            "title": "Amount Cents",
            "type": "integer"
          },
          "description": {
            "minLength": 1,
            "title": "Description",
            "type": "string"
          }
        },
        "required": [
          "description",
          "amount_cents"
        ],
        "title": "Discount",
        "type": "object"
      },
      "EmbedRequest": {
        "additionalProperties": false,
        "properties": {
          "texts": {
            "description": "Item descriptions",
            "items": {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            "maxItems": 256,
            "minItems": 1,
            "title": "Texts",
            "type": "array"
          }
        },
        "required": [
          "texts"
        ],
        "title": "EmbedRequest",
        "type": "object"
      },
      "EmbedResponse": {
        "properties": {
          "dimensions": {
            "title": "Dimensions",
            "type": "integer"
          },
          "embedder": {
            "description": "Which embedder produced the vectors",
            "title": "Embedder",
            "type": "string"
          },
          "embeddings": {
            "description": "One L2-normalised vector per text, in order",
            "items": {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            "title": "Embeddings",
            "type": "array"
          }
        },
        "required": [
          "embedder",
          "dimensions",
          "embeddings"
        ],
        "title": "EmbedResponse",
        "type": "object"
      },
      "ExtractRequest": {
        "additionalProperties": false,
        "description": "Identifies the receipt image to extract. Exactly one source must be given.",
        "properties": {
          "image_base64": {
            "anyOf": [
              {
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Base64-encoded image bytes",
            "title": "Image Base64"
          },
          "image_id": {
            "anyOf": [
              {
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "ID of an image already held in receipt storage",
            "title": "Image Id"
          }
        },
        "title": "ExtractRequest",
        "type": "object"
      },
      "ExtractedItem": {
        "properties": {
          "name": {
            "description": "Item name as printed on the receipt",
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "quantity": {
            "default": 1,
            "description": "Count or weight; may be fractional",
            "exclusiveMinimum": 0.0,
            "title": "Quantity",
            "type": "number"
          },
          "total_cents": {
            "description": "Line total; negative for refunds or voids",
            "title": "Total Cents",
            "type": "integer"
          },
          "unit_price_cents": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Unit Price Cents"
          }
        },
        "required": [
          "name",
          "total_cents"
        ],
        "title": "ExtractedItem",
        "type": "object"
      },
      "ExtractedReceipt": {
        "properties": {
          "discounts": {
            "items": {
              "$ref": "#/components/schemas/Discount"
            },
            "title": "Discounts",
            "type": "array"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/ExtractedItem"
            },
            "title": "Items",
            "type": "array"
          },
          "purchased_on": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Purchased On"
          },
          "store": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Store"
          },
          "subtotal_cents": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "Pre-tax amount after discounts, as printed",
            "title": "Subtotal Cents"
          },
          "tax_cents": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tax Cents"
          },
          "total_cents": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Total Cents"
          },
          "warnings": {
            "description": "Non-fatal issues found during extraction",
            "items": {
              "type": "string"
            },
            "title": "Warnings",
            "type": "array"
          }
        },
        "title": "ExtractedReceipt",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HistoryStatus": {
        "properties": {
          "history_size": {
            "title": "History Size",
            "type": "integer"
          },
          "household_id": {
            "title": "Household Id",
            "type": "string"
          },
          "min_history": {
            "description": "Labelled items needed before predictions are made",
            "title": "Min History",
            "type": "integer"
          },
          "model_version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Version of the model currently serving, if one is built",
            "title": "Model Version"
          },
          "ready": {
            "title": "Ready",
            "type": "boolean"
          }
        },
        "required": [
          "household_id",
          "history_size",
          "min_history",
          "ready"
        ],
        "title": "HistoryStatus",
        "type": "object"
      },
      "ItemPrediction": {
        "properties": {
          "alternatives": {
            "items": {
              "$ref": "#/components/schemas/Alternative"
            },
            "title": "Alternatives",
            "type": "array"
          },
          "confidence": {
            "description": "Probability the owner set is correct, 0 to 1",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Confidence",
            "type": "number"
          },
          "item_id": {
            "title": "Item Id",
            "type": "string"
          },
          "owners": {
            "description": "Predicted person ids; empty when unknown",
            "items": {
              "type": "string"
            },
            "title": "Owners",
            "type": "array"
          },
          "status": {
            "$ref": "#/components/schemas/PredictionStatus"
          }
        },
        "required": [
          "item_id",
          "status",
          "confidence"
        ],
        "title": "ItemPrediction",
        "type": "object"
      },
      "ObservationIn": {
        "additionalProperties": false,
        "description": "One confirmed item and who owns it. Resending an observation_id updates it in place.",
        "properties": {
          "description": {
            "maxLength": 512,
            "minLength": 1,
            "title": "Description",
            "type": "string"
          },
          "member_ids": {
            "description": "Person ids in the household on that date",
            "items": {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            "minItems": 1,
            "title": "Member Ids",
            "type": "array"
          },
          "observation_id": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Observation Id",
            "type": "string"
          },
          "owner_ids": {
            "description": "Person ids who own the item",
            "items": {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            "minItems": 1,
            "title": "Owner Ids",
            "type": "array"
          },
          "purchased_on": {
            "description": "Original purchase date; a correction keeps it",
            "format": "date",
            "title": "Purchased On",
            "type": "string"
          },
          "source": {
            "$ref": "#/components/schemas/AssignmentSource",
            "default": "manual"
          }
        },
        "required": [
          "observation_id",
          "purchased_on",
          "description",
          "member_ids",
          "owner_ids"
        ],
        "title": "ObservationIn",
        "type": "object"
      },
      "Person": {
        "properties": {
          "id": {
            "minLength": 1,
            "title": "Id",
            "type": "string"
          },
          "name": {
            "minLength": 1,
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name"
        ],
        "title": "Person",
        "type": "object"
      },
      "PredictItem": {
        "properties": {
          "description": {
            "description": "Item name, raw or normalised",
            "minLength": 1,
            "title": "Description",
            "type": "string"
          },
          "item_id": {
            "minLength": 1,
            "title": "Item Id",
            "type": "string"
          }
        },
        "required": [
          "item_id",
          "description"
        ],
        "title": "PredictItem",
        "type": "object"
      },
      "PredictRequest": {
        "additionalProperties": false,
        "properties": {
          "household_id": {
            "description": "Letters, digits, - and _",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
            "title": "Household Id",
            "type": "string"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/PredictItem"
            },
            "title": "Items",
            "type": "array"
          },
          "people": {
            "items": {
              "$ref": "#/components/schemas/Person"
            },
            "minItems": 1,
            "title": "People",
            "type": "array"
          }
        },
        "required": [
          "household_id",
          "people",
          "items"
        ],
        "title": "PredictRequest",
        "type": "object"
      },
      "PredictResponse": {
        "properties": {
          "model_version": {
            "title": "Model Version",
            "type": "string"
          },
          "predictions": {
            "items": {
              "$ref": "#/components/schemas/ItemPrediction"
            },
            "title": "Predictions",
            "type": "array"
          }
        },
        "required": [
          "model_version",
          "predictions"
        ],
        "title": "PredictResponse",
        "type": "object"
      },
      "PredictionStatus": {
        "enum": [
          "predicted",
          "unknown"
        ],
        "title": "PredictionStatus",
        "type": "string"
      },
      "RetrainRunOut": {
        "properties": {
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "finished_at": {
            "title": "Finished At",
            "type": "string"
          },
          "history_size": {
            "title": "History Size",
            "type": "integer"
          },
          "household_id": {
            "title": "Household Id",
            "type": "string"
          },
          "metrics": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Metrics"
          },
          "new_observations": {
            "title": "New Observations",
            "type": "integer"
          },
          "reason": {
            "description": "first, new-observations or interval",
            "title": "Reason",
            "type": "string"
          },
          "seconds": {
            "title": "Seconds",
            "type": "number"
          },
          "started_at": {
            "title": "Started At",
            "type": "string"
          },
          "version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Model version built; null if history was too small",
            "title": "Version"
          }
        },
        "required": [
          "household_id",
          "started_at",
          "finished_at",
          "seconds",
          "history_size",
          "new_observations",
          "reason",
          "version"
        ],
        "title": "RetrainRunOut",
        "type": "object"
      },
      "UpsertObservationsRequest": {
        "additionalProperties": false,
        "properties": {
          "observations": {
            "items": {
              "$ref": "#/components/schemas/ObservationIn"
            },
            "maxItems": 5000,
            "minItems": 1,
            "title": "Observations",
            "type": "array"
          }
        },
        "required": [
          "observations"
        ],
        "title": "UpsertObservationsRequest",
        "type": "object"
      },
      "UpsertObservationsResponse": {
        "properties": {
          "history_size": {
            "title": "History Size",
            "type": "integer"
          },
          "household_id": {
            "title": "Household Id",
            "type": "string"
          },
          "received": {
            "title": "Received",
            "type": "integer"
          }
        },
        "required": [
          "household_id",
          "received",
          "history_size"
        ],
        "title": "UpsertObservationsResponse",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Divvy ML",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/embed": {
      "post": {
        "operationId": "embed_embed_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EmbedRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmbedResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Embed",
        "tags": [
          "embeddings"
        ]
      }
    },
    "/health": {
      "get": {
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Health Health Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    },
    "/ownership/households/{household_id}/history": {
      "get": {
        "operationId": "history_status_ownership_households__household_id__history_get",
        "parameters": [
          {
            "in": "path",
            "name": "household_id",
            "required": true,
            "schema": {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
              "title": "Household Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HistoryStatus"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "History Status",
        "tags": [
          "ownership"
        ]
      }
    },
    "/ownership/households/{household_id}/observations": {
      "put": {
        "description": "Add or update confirmed observations by id; `replace=true` swaps the whole history.",
        "operationId": "upsert_observations_ownership_households__household_id__observations_put",
        "parameters": [
          {
            "in": "path",
            "name": "household_id",
            "required": true,
            "schema": {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
              "title": "Household Id",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "replace",
            "required": false,
            "schema": {
              "default": false,
              "title": "Replace",
              "type": "boolean"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpsertObservationsRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UpsertObservationsResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Upsert Observations",
        "tags": [
          "ownership"
        ]
      }
    },
    "/ownership/households/{household_id}/observations/{observation_id}": {
      "delete": {
        "operationId": "delete_observation_ownership_households__household_id__observations__observation_id__delete",
        "parameters": [
          {
            "in": "path",
            "name": "household_id",
            "required": true,
            "schema": {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
              "title": "Household Id",
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "observation_id",
            "required": true,
            "schema": {
              "title": "Observation Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Delete Observation",
        "tags": [
          "ownership"
        ]
      }
    },
    "/ownership/predict": {
      "post": {
        "description": "Predict who owns each item from the household's stored history.\n\nItems come back as `unknown` while the household has too little history, or when nothing in it\nresembles the item.",
        "operationId": "predict_ownership_predict_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PredictRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PredictResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Predict",
        "tags": [
          "ownership"
        ]
      }
    },
    "/ownership/retraining": {
      "get": {
        "description": "Recent scheduled retraining runs, newest first; empty when the schedule is off.",
        "operationId": "retraining_runs_ownership_retraining_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/RetrainRunOut"
                  },
                  "title": "Response Retraining Runs Ownership Retraining Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Retraining Runs",
        "tags": [
          "ownership"
        ]
      }
    },
    "/receipts/extract": {
      "post": {
        "operationId": "extract_receipts_extract_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExtractRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExtractedReceipt"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Extract",
        "tags": [
          "receipts"
        ]
      }
    }
  }
}
