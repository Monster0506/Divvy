{
  "components": {
    "schemas": {
      "Alternative": {
        "properties": {
          "confidence": {
            "description": "Probability the owner set is correct, 0 to 1",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Confidence",
            "type": "number"
          },
          "owners": {
            "description": "Person ids",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "title": "Owners",
            "type": "array"
          }
        },
        "required": [
          "owners",
          "confidence"
        ],
        "title": "Alternative",
        "type": "object"
      },
      "Discount": {
        "properties": {
          "amount_cents": {
            "description": "Discount size as a positive amount",
            "minimum": 0.0,
            "title": "Amount Cents",
            "type": "integer"
          },
          "description": {
            "minLength": 1,
            "title": "Description",
            "type": "string"
          }
        },
        "required": [
          "description",
          "amount_cents"
        ],
        "title": "Discount",
        "type": "object"
      },
      "EmbedRequest": {
        "additionalProperties": false,
        "properties": {
          "texts": {
            "description": "Item descriptions",
            "items": {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            "maxItems": 256,
            "minItems": 1,
            "title": "Texts",
            "type": "array"
          }
        },
        "required": [
          "texts"
        ],
        "title": "EmbedRequest",
        "type": "object"
      },
      "EmbedResponse": {
        "properties": {
          "dimensions": {
            "title": "Dimensions",
            "type": "integer"
          },
          "embedder": {
            "description": "Which embedder produced the vectors",
            "title": "Embedder",
            "type": "string"
          },
          "embeddings": {
            "description": "One L2-normalised vector per text, in order",
            "items": {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            "title": "Embeddings",
            "type": "array"
          }
        },
        "required": [
          "embedder",
          "dimensions",
          "embeddings"
        ],
        "title": "EmbedResponse",
        "type": "object"
      },
      "ExtractRequest": {
        "additionalProperties": false,
        "description": "Identifies the receipt image to extract. Exactly one source must be given.",
        "properties": {
          "image_base64": {
            "anyOf": [
              {
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Base64-encoded image bytes",
            "title": "Image Base64"
          },
          "image_id": {
            "anyOf": [
              {
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "ID of an image already held in receipt storage",
            "title": "Image Id"
          }
        },
        "title": "ExtractRequest",
        "type": "object"
      },
      "ExtractedItem": {
        "properties": {
          "name": {
            "description": "Item name as printed on the receipt",
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "quantity": {
            "default": 1,
            "description": "Count or weight; may be fractional",
            "exclusiveMinimum": 0.0,
            "title": "Quantity",
            "type": "number"
          },
          "total_cents": {
            "description": "Line total; negative for refunds or voids",
            "title": "Total Cents",
            "type": "integer"
          },
          "unit_price_cents": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Unit Price Cents"
          }
        },
        "required": [
          "name",
          "total_cents"
        ],
        "title": "ExtractedItem",
        "type": "object"
      },
      "ExtractedReceipt": {
        "properties": {
          "discounts": {
            "items": {
              "$ref": "#/components/schemas/Discount"
            },
            "title": "Discounts",
            "type": "array"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/ExtractedItem"
            },
            "title": "Items",
            "type": "array"
          },
          "purchased_on": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Purchased On"
          },
          "store": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Store"
          },
          "subtotal_cents": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "Pre-tax amount after discounts, as printed",
            "title": "Subtotal Cents"
          },
          "tax_cents": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tax Cents"
          },
          "total_cents": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Total Cents"
          },
          "warnings": {
            "description": "Non-fatal issues found during extraction",
            "items": {
              "type": "string"
            },
            "title": "Warnings",
            "type": "array"
          }
        },
        "title": "ExtractedReceipt",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "ItemPrediction": {
        "properties": {
          "alternatives": {
            "items": {
              "$ref": "#/components/schemas/Alternative"
            },
            "title": "Alternatives",
            "type": "array"
          },
          "confidence": {
            "description": "Probability the owner set is correct, 0 to 1",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Confidence",
            "type": "number"
          },
          "item_id": {
            "title": "Item Id",
            "type": "string"
          },
          "owners": {
            "description": "Predicted person ids; empty when unknown",
            "items": {
              "type": "string"
            },
            "title": "Owners",
            "type": "array"
          },
          "status": {
            "$ref": "#/components/schemas/PredictionStatus"
          }
        },
        "required": [
          "item_id",
          "status",
          "confidence"
        ],
        "title": "ItemPrediction",
        "type": "object"
      },
      "Person": {
        "properties": {
          "id": {
            "minLength": 1,
            "title": "Id",
            "type": "string"
          },
          "name": {
            "minLength": 1,
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name"
        ],
        "title": "Person",
        "type": "object"
      },
      "PredictItem": {
        "properties": {
          "description": {
            "description": "Item name, raw or normalised",
            "minLength": 1,
            "title": "Description",
            "type": "string"
          },
          "item_id": {
            "minLength": 1,
            "title": "Item Id",
            "type": "string"
          }
        },
        "required": [
          "item_id",
          "description"
        ],
        "title": "PredictItem",
        "type": "object"
      },
      "PredictRequest": {
        "additionalProperties": false,
        "properties": {
          "household_id": {
            "minLength": 1,
            "title": "Household Id",
            "type": "string"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/PredictItem"
            },
            "title": "Items",
            "type": "array"
          },
          "people": {
            "items": {
              "$ref": "#/components/schemas/Person"
            },
            "minItems": 1,
            "title": "People",
            "type": "array"
          }
        },
        "required": [
          "household_id",
          "people",
          "items"
        ],
        "title": "PredictRequest",
        "type": "object"
      },
      "PredictResponse": {
        "properties": {
          "model_version": {
            "title": "Model Version",
            "type": "string"
          },
          "predictions": {
            "items": {
              "$ref": "#/components/schemas/ItemPrediction"
            },
            "title": "Predictions",
            "type": "array"
          }
        },
        "required": [
          "model_version",
          "predictions"
        ],
        "title": "PredictResponse",
        "type": "object"
      },
      "PredictionStatus": {
        "enum": [
          "predicted",
          "unknown"
        ],
        "title": "PredictionStatus",
        "type": "string"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Divvy ML",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/embed": {
      "post": {
        "operationId": "embed_embed_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EmbedRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmbedResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Embed",
        "tags": [
          "embeddings"
        ]
      }
    },
    "/health": {
      "get": {
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Health Health Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    },
    "/ownership/predict": {
      "post": {
        "operationId": "predict_ownership_predict_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PredictRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PredictResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Predict",
        "tags": [
          "ownership"
        ]
      }
    },
    "/receipts/extract": {
      "post": {
        "operationId": "extract_receipts_extract_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExtractRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExtractedReceipt"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Extract",
        "tags": [
          "receipts"
        ]
      }
    }
  }
}
