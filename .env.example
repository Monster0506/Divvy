# Copy this file to .env and fill in real values:  cp .env.example .env
# .env is gitignored. Never commit it.

# --- Postgres (db service) ---
# Database name created on first start
POSTGRES_DB=divvy
# Database user created on first start
POSTGRES_USER=divvy
# Use a strong password in production, e.g.: openssl rand -hex 24
# Changing it later does NOT change an existing database (see README: backups)
POSTGRES_PASSWORD=change-me

# --- Ktor server ---
# Shared secret clients send to authenticate with the API.
# Generate one with: openssl rand -hex 24
API_KEY=change-me

# --- ML service: receipt extraction ---
# Key for the Qwen vision API. Without it /receipts/extract answers 503 and the rest still works.
QWEN_API_KEY=
# Optional override; the default is https://maas.qwencloudapi.com/compatible-mode/v1
# QWEN_BASE_URL=
# Set to false to normalise product names with rules only (no extra model call)
# QWEN_LLM_NORMALIZE=true
# Demos only: set to true so a household with no history still gets confident owner guesses
# DIVVY_DEMO_MODEL=
