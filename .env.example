# Copy this file to .env and fill in real values:  cp .env.example .env
# .env is gitignored. Never commit it.

# --- Postgres (db service) ---
# Database name created on first start
POSTGRES_DB=divvy
# Database user created on first start
POSTGRES_USER=divvy
# Use a strong password in production, e.g.: openssl rand -hex 24
# Changing it later does NOT change an existing database (see README: backups)
POSTGRES_PASSWORD=change-me

# --- Ktor server ---
# Shared secret clients send to authenticate with the API.
# Generate one with: openssl rand -hex 24
API_KEY=change-me
