# Copied to deploy/prod.env by `make deploy`, which fills in the generated secrets.
# deploy/prod.env is gitignored and uploaded to the server as /opt/divvy/.env.
POSTGRES_DB=divvy
POSTGRES_USER=divvy
POSTGRES_PASSWORD=__POSTGRES_PASSWORD__
API_KEY=__API_KEY__
# Put your Qwen key here (or export QWEN_API_KEY before running make). Without it receipts are not read.
QWEN_API_KEY=
QWEN_LLM_NORMALIZE=true
