[Unit]
Description=Deploy updated Divvy server code from main
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=oneshot
EnvironmentFile=/etc/divvy/auto-update.env
ExecStart=/usr/bin/bash /usr/local/libexec/divvy-auto-update
TimeoutStartSec=30min
UMask=0077
